# Copy to .env and fill in values

# Password required to submit check-ins via the /checkin page
CHECKIN_PASSWORD=changeme

# GeoNames username for town population lookups (make town-pops)
# Register free at geonames.org, then enable free web services in account settings
GEONAMES_USER=

# Google Cloud project ID (used to push/pull images from Artifact Registry)
PROJECT_ID=your-project-id

# Production domain and email for Let's Encrypt SSL cert (leave blank for local dev)
DOMAIN=
CERTBOT_EMAIL=
